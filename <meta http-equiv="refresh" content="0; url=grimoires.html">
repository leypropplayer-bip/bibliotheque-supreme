  </div>

  <div class="cta">
    <h2>Commande assistée</h2>
    <p>Utilise le code <strong>0163344</strong> pour un accompagnement personnalisé</p>
    <a href="https://wa.me/50932963889" class="wa">📩 Contacter sur WhatsApp</a>
  </div>
</section>

<footer>
  <p>© 2025 — La Bibliothèque Suprême</p>
  <p>Partenaire Amazon officiel — Des commissions peuvent être perçues.</p>
  <p><i>« Le savoir vient au sein de la CDM »</i></p>
</footer>

<script>
const stars = document.getElementById('stars');
for(let i = 0; i < 60; i++){
  const s = document.createElement('div');
  s.className = 'star';
  s.style.cssText = `
    left:${Math.random()*100}%;
    top:${Math.random()*100}%;
    --d:${2+Math.random()*4}s;
    animation-delay:${Math.random()*4}s;
  `;
  stars.appendChild(s);
}
</script>

</body>
</html>
